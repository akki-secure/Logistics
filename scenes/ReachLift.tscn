mesh = SubResource("BoxMesh_BodyRearWall")
surface_material_override/0 = SubResource("Mat_White")

; オペレーターエリア背面壁（Z=0.55、BodyLower前面と揃える）
; 後方から見たとき：この壁でオペレーターエリアが見えなくなる → 閉じた車体に見える
; 前方から見たとき：この壁の手前にオペレーターエリア（床・レール・コンソール）が見える
[node name="BodyFrontUpperWall" type="MeshInstance3D" parent="."]
position = Vector3(0, 1.275, 0.55)
mesh = SubResource("BoxMesh_BodyFrontUpperWall")
surface_material_override/0 = SubResource("Mat_White")

