mesh = SubResource("BoxMesh_BaseLower")
surface_material_override/0 = SubResource("Mat_White")

; 車体下部（バッテリー・機械エリア）: 後方Z=0.55〜1.27, Y=0.15〜1.0
; オペレーター乗車スペースは前方Z=-0.5〜0.55 に確保
[node name="BodyLower" type="MeshInstance3D" parent="."]
position = Vector3(0, 0.575, 0.91)
mesh = SubResource("BoxMesh_BodyLower")
surface_material_override/0 = SubResource("Mat_White")

; 左側面パネル（車体下部の上に続く壁、Y=1.0〜1.55）
[node name="BodySideLeft" type="MeshInstance3D" parent="."]
