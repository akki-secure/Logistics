[sub_resource type="BoxMesh" id="BoxMesh_BodyRearWall"]
size = Vector3(1.05, 0.55, 0.07)

; オペレーターエリア背面壁（BodyLowerの前面と同一Z=0.55に配置）
; これにより後方カメラからはオペレーターエリアが見えなくなる
