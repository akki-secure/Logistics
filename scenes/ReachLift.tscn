; リーチリフト 3Dシーン（NICHIYU PLATTER参考）
; 座標系: 前方=-Z, 上方=+Y, 原点=車体中心・地面レベル

[gd_scene load_steps=28 format=3]

; ===== マテリアル（7種） =====

[sub_resource type="StandardMaterial3D" id="Mat_White"]
albedo_color = Color(0.88, 0.90, 0.90, 1)

[sub_resource type="StandardMaterial3D" id="Mat_Black"]
albedo_color = Color(0.12, 0.12, 0.12, 1)

[sub_resource type="StandardMaterial3D" id="Mat_DarkGray"]
albedo_color = Color(0.22, 0.22, 0.22, 1)

[sub_resource type="StandardMaterial3D" id="Mat_Red"]
albedo_color = Color(0.85, 0.10, 0.08, 1)

[sub_resource type="StandardMaterial3D" id="Mat_TireBlack"]
albedo_color = Color(0.08, 0.08, 0.08, 1)

[sub_resource type="StandardMaterial3D" id="Mat_WhiteWheel"]
albedo_color = Color(0.85, 0.85, 0.85, 1)

; LEDライト発光面（エミッシブ・ウォームホワイト）
[sub_resource type="StandardMaterial3D" id="Mat_LED"]
albedo_color = Color(1.0, 1.0, 0.95, 1)
emission_enabled = true
emission = Color(1.0, 0.98, 0.85, 1)
emission_energy_multiplier = 3.0

; ===== メッシュ（17種） =====

; 車体ベースフレーム（底面）: 幅1.15m × 高さ0.15m × 奥行0.9m
[sub_resource type="BoxMesh" id="BoxMesh_BaseLower"]
size = Vector3(1.15, 0.15, 0.9)

; 車体下部（バッテリー・機械エリア、後方に配置）: 幅1.05m × 高さ0.85m × 奥行0.72m
[sub_resource type="BoxMesh" id="BoxMesh_BodyLower"]
size = Vector3(1.05, 0.85, 0.72)

